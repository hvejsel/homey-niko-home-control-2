{
  "name": { "en": "Thermostat", "nl": "Thermostaat", "da": "Termostat" },
  "class": "thermostat",
  "capabilities": ["measure_temperature", "target_temperature", "niko_program", "niko_demand"],
  "capabilitiesOptions": {
    "target_temperature": { "min": 5, "max": 30, "step": 0.5 }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}
